# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Required. RLS is enabled with no policies (default-deny for anon/authenticated),
# so the app's API routes use the service_role key to actually read/write.
# This key bypasses RLS -- keep it server-side only, never prefix it with
# NEXT_PUBLIC_ or reference it from any client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
